# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api

# URL publica do proprio backend (usada para montar URLs de imagens locais)
PUBLIC_API_URL=http://localhost:4000

# URL do site publico (usada em links de e-mail, CORS e mensagens)
PUBLIC_SITE_URL=http://localhost:3000

# Origens autorizadas no CORS, separadas por virgula
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nicolas_vendedor?schema=public"

# ---------------------------------------------------------------------------
# Autenticacao
# ---------------------------------------------------------------------------
# Gere valores fortes com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-este-valor-em-producao-access
JWT_REFRESH_SECRET=troque-este-valor-em-producao-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Cookies: em producao com dominios diferentes use SESSION_COOKIE_SAMESITE=none e SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Bloqueio por tentativas de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------------------------------------------------------------------------
# Armazenamento de imagens
# STORAGE_DRIVER=local  -> salva em disco e serve via /uploads
# STORAGE_DRIVER=s3     -> compativel com AWS S3, Cloudflare R2, Supabase Storage
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=8

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Metricas
# ---------------------------------------------------------------------------
# Janela (minutos) para nao contar a mesma visualizacao do mesmo visitante
ANALYTICS_DEDUPE_MINUTES=30

# ---------------------------------------------------------------------------
# E-mail (recuperacao de senha). Sem SMTP configurado o link e escrito no log.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Nicolas Vendedor <nao-responda@nicolasvendedor.com.br>"

# ---------------------------------------------------------------------------
# Dados iniciais (npm run db:seed)
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME="Nicolas Vendedor"
SEED_ADMIN_EMAIL=admin@nicolasvendedor.com.br
SEED_ADMIN_PASSWORD=Admin@123456
