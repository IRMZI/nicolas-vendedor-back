// Prisma schema - Nicolas Vendedor
// Banco relacional PostgreSQL com soft delete, metricas e auditoria.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EDITOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  ON_ORDER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  PROPOSAL_SENT
  CONVERTED
  LOST
}

enum LeadSource {
  SITE_FORM
  PRODUCT_INTEREST
  WHATSAPP
  MANUAL
  OTHER
}

enum AnalyticsEventType {
  PRODUCT_VIEW
  CATEGORY_VIEW
  SEARCH
  SEARCH_NO_RESULT
  WHATSAPP_CLICK
  SHARE_CLICK
  LEAD_SUBMIT
  PAGE_VIEW
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  ARCHIVE
  STATUS_CHANGE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  SETTINGS_UPDATE
  BULK_ACTION
}

// ---------------------------------------------------------------------------
// Usuarios e autenticacao
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(ADMIN)
  isActive            Boolean   @default(true)
  avatarUrl           String?
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]
  leadNotes      LeadHistory[]

  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// ---------------------------------------------------------------------------
// Catalogo
// ---------------------------------------------------------------------------

model Category {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  description    String?
  imageUrl       String?
  icon           String?
  parentId       String?
  position       Int       @default(0)
  isActive       Boolean   @default(true)
  showOnHome     Boolean   @default(false)
  seoTitle       String?
  seoDescription String?
  viewCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]
  events   AnalyticsEvent[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, deletedAt])
  @@index([position])
  @@map("categories")
}

model Product {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  sku                String?             @unique
  shortDescription   String?
  description        String?
  price              Decimal             @db.Decimal(12, 2)
  comparePrice       Decimal?            @db.Decimal(12, 2)
  stock              Int?
  trackStock         Boolean             @default(false)
  status             ProductStatus       @default(DRAFT)
  availability       ProductAvailability @default(IN_STOCK)
  isFeatured         Boolean             @default(false)
  viewCount          Int                 @default(0)
  whatsappClickCount Int                 @default(0)
  shareCount         Int                 @default(0)
  leadCount          Int                 @default(0)
  seoTitle           String?
  seoDescription     String?
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  images     ProductImage[]
  categories ProductCategory[]
  tags       ProductTag[]
  attributes ProductAttribute[]
  leads      Lead[]
  events     AnalyticsEvent[]

  @@index([slug])
  @@index([status, deletedAt])
  @@index([isFeatured, status])
  @@index([createdAt])
  @@index([viewCount])
  @@index([price])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  url        String
  storageKey String?
  alt        String?
  position   Int      @default(0)
  isPrimary  Boolean  @default(false)
  width      Int?
  height     Int?
  sizeBytes  Int?
  mimeType   String?
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  name      String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_attributes")
}

// ---------------------------------------------------------------------------
// Leads / contatos
// ---------------------------------------------------------------------------

model Lead {
  id        String     @id @default(uuid())
  name      String
  phone     String?
  email     String?
  productId String?
  message   String?
  source    LeadSource @default(SITE_FORM)
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  product Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  history LeadHistory[]

  @@index([status, createdAt])
  @@index([productId])
  @@index([deletedAt])
  @@map("leads")
}

model LeadHistory {
  id         String      @id @default(uuid())
  leadId     String
  userId     String?
  fromStatus LeadStatus?
  toStatus   LeadStatus?
  note       String?
  createdAt  DateTime    @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_history")
}

// ---------------------------------------------------------------------------
// Conteudo do site
// ---------------------------------------------------------------------------

model Banner {
  id           String    @id @default(uuid())
  title        String
  subtitle     String?
  imageDesktop String?
  imageMobile  String?
  buttonLabel  String?
  link         String?
  position     Int       @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([isActive, position])
  @@map("banners")
}

model Testimonial {
  id           String    @id @default(uuid())
  customerName String
  photoUrl     String?
  content      String
  rating       Int       @default(5)
  role         String?
  position     Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([isActive, position])
  @@map("testimonials")
}

model HomeSection {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  subtitle  String?
  isEnabled Boolean  @default(true)
  position  Int      @default(0)
  config    Json?
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("home_sections")
}

model Setting {
  id                String   @id @default("singleton")
  siteName          String   @default("Nicolas Vendedor")
  tagline           String?
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String   @default("#2563eb")
  secondaryColor    String   @default("#0f172a")
  phone             String?
  whatsapp          String?
  email             String?
  address           String?
  businessHours     String?
  socialLinks       Json?
  whatsappTemplate  String   @default("Ola, Nicolas! Vi o produto {produto} no seu site e gostaria de saber mais. Link: {link}")
  footerText        String?
  aboutTitle        String?
  aboutContent      String?
  aboutImageUrl     String?
  benefits          Json?
  seoTitle          String?
  seoDescription    String?
  seoKeywords       String?
  ogImageUrl        String?
  googleAnalyticsId String?
  metaPixelId       String?
  customScripts     String?
  privacyPolicy     String?
  termsOfUse        String?
  cookieNotice      String?
  updatedAt         DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Metricas e auditoria
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id           String             @id @default(uuid())
  type         AnalyticsEventType
  productId    String?
  categoryId   String?
  searchTerm   String?
  resultCount  Int?
  path         String?
  referrer     String?
  referrerHost String?
  device       DeviceType         @default(UNKNOWN)
  anonymousId  String?
  sessionId    String?
  createdAt    DateTime           @default(now())

  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([productId, type, createdAt])
  @@index([categoryId, type, createdAt])
  @@index([createdAt])
  @@index([anonymousId, type, createdAt])
  @@index([searchTerm])
  @@map("analytics_events")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  userName  String?
  action    AuditAction
  entity    String
  entityId  String?
  summary   String?
  changes   Json?
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}
